# odin-pango: its place in the binding graph
# Render:  d2 diags/odin-pango.d2 diags/odin-pango.svg

direction: down

title: "odin-pango" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-pango\nPango and PangoCairo 1.52.1" {
  style.fill: "#eef6ff"
}
lib: "pango (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"pango:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection pango
this -> lib: foreign import
